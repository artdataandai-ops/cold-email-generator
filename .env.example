OPENAI_API_KEY=sk-...
APIFY_TOKEN=apify_api_...
APIFY_LINKEDIN_ACTOR=LQQIXN9Othf8f7R5n
APIFY_LINKEDIN_POST_LIMIT=2
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
RECENCY_DAYS=60
SEARCH_MAX_RESULTS=5
MAX_NEWS_ITEMS=8
# Default is off: rely on the prospect's own news/blog pages only.
# Toggle on per-request via UI "Advanced settings → Enable external web search".
DISABLE_WEB_SEARCH=true
# LinkedIn fetch via Apify. Default on (when a LinkedIn URL is provided); flip to
# true to force-skip it even when a URL is pasted (useful for testing or to save Apify cost).
DISABLE_LINKEDIN=false
# When true, skip email drafting if neither news nor LinkedIn posts were found.
# Saves the LLM cost on dead-end runs. Default false (always draft).
REQUIRE_CONTEXT_FOR_EMAIL=false
LINKEDIN_CACHE_HOURS=24

# --- Playwright/ScrapegraphAI loader knobs (all optional) ---
# Routes Playwright through a proxy. Leave SCRAPEGRAPH_PROXY_SERVER empty to disable.
# Use "broker" for ScrapegraphAI's bundled free-proxy rotation (slow, unreliable, last
# resort), or an explicit "http://host:port" / "https://host:port" for your own proxy.
SCRAPEGRAPH_PROXY_SERVER=
SCRAPEGRAPH_PROXY_USERNAME=
SCRAPEGRAPH_PROXY_PASSWORD=
# "domcontentloaded" (fast, scrapegraph default) or "networkidle" (waits for JS to
# settle — better for SPA news pages, slower).
SCRAPEGRAPH_LOAD_STATE=domcontentloaded
# Per-page retry attempts inside the loader (scrapegraph default is 1 = no retry).
SCRAPEGRAPH_RETRY_LIMIT=2
# Per-page timeout in seconds.
SCRAPEGRAPH_PLAYWRIGHT_TIMEOUT=60
